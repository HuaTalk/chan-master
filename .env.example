# ── LLM provider ──
# DeepSeek (default when DEEPSEEK_API_KEY is set)
DEEPSEEK_API_KEY=
# OpenAI (fallback when DEEPSEEK_API_KEY is not set)
# OPENAI_API_KEY=

# Model name
#   DeepSeek defaults: deepseek-v4-pro (flash: deepseek-v4-flash)
#   OpenAI defaults:   gpt-4.1-mini
# CHAN_MASTER_MODEL=deepseek-v4-pro

# Custom API base URL (overrides the provider default)
# CHAN_MASTER_BASE_URL=https://api.deepseek.com/v1

# ── Question buffer ──
# Enabled by default. Set to 0 to disable buffered question generation.
# CHAN_MASTER_BUFFER_QUESTION_NUM=5
# CHAN_MASTER_BUFFER_REFRESH_PERCENT=70

# ── Session storage ──
# CHAN_MASTER_OUT_DIR=./out
